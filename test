  const ring = { "Projet central": 0, "Organisations locales": 160, "Porteurs / partenaires économiques": 200, "Opposants nommés": 280, "Habitants cités": 280, "Élus critiques": 380, "Élus favorables / nuancés": 380, "Réseau élargi": 460, "Médias et sources": 460 };
  const byGroup = {}; nodes.forEach(n => (byGroup[n.group] ||= []).push(n));
  nodes.forEach(n => {
    if(n.id === central) { n.x = width/2; n.y = height/2; return; }
    const arr = byGroup[n.group], idx = arr.indexOf(n), total = arr.length;
    let base = Object.keys(byGroup).indexOf(n.group) * 0.55;
    if(n.group === "Élus favorables / nuancés") base = -0.15;
    if(n.group === "Élus critiques") base = 2.45;
    const angle = base + idx * (Math.PI*2/Math.max(total,1));
    const r = ring[n.group] || 320;
    n.x = width/2 + Math.cos(angle)*r; n.y = height/2 + Math.sin(angle)*r;
  });
}
initialPosition();

// Simple organic physics
function tick() {
  for(let k=0;k<2;k++) {
    // Link attraction
    links.forEach(l => {
      const dx = l.target.x-l.source.x, dy = l.target.y-l.source.y, dist = Math.hypot(dx,dy) || 1;
      const desired = l.source.id===central || l.target.id===central ? 180 : 130;
      const f = (dist-desired)*0.008, fx = dx/dist*f, fy = dy/dist*f;
      if(!l.source.fixed) { l.source.x += fx; l.source.y += fy; }
      if(!l.target.fixed) { l.target.x -= fx; l.target.y -= fy; }
    });
    // Node repulsion
    for(let i=0;i<nodes.length;i++) {
      for(let j=i+1;j<nodes.length;j++) {
        const a=nodes[i], b=nodes[j], dx=b.x-a.x, dy=b.y-a.y, dist=Math.hypot(dx,dy)||1, min=a.size+b.size+45;
        if(dist < min) { const f=(min-dist)/dist*0.025; if(!a.fixed) {a.x-=dx*f; a.y-=dy*f;} if(!b.fixed) {b.x+=dx*f; b.y+=dy*f;} }
      }
    }
    // Centering force
    nodes.forEach(n => {
      if(n.id !== central && !n.fixed) { n.x += (width/2 - n.x)*0.001; n.y += (height/2 - n.y)*0.001; }
      n.x = Math.max(50, Math.min(width-50, n.x)); n.y = Math.max(50, Math.min(height-50, n.y));
    });
  }
  
  // Update positions (curved links)
  linkEls.forEach((el,i) => { 
    const l = links[i]; 
    const dx = l.target.x - l.source.x;
    const dy = l.target.y - l.source.y;
    const dr = Math.hypot(dx, dy) * 1.5; // Bezier arc
    el.setAttribute('d', `M${l.source.x},${l.source.y} A${dr},${dr} 0 0,1 ${l.target.x},${l.target.y}`); 
  });
  
  nodeEls.forEach((el,i) => el.setAttribute('transform',`translate(${nodes[i].x},${nodes[i].y})`));
  requestAnimationFrame(tick);
}
tick();

let selectedNodeId = null;

function getNeighbors(nodeId) {
  const neigh = new Set([nodeId]);
  links.forEach(l => { 
    if(l.source.id===nodeId) neigh.add(l.target.id); 
    if(l.target.id===nodeId) neigh.add(l.source.id); 
  });
  return neigh;
}

function handleHover(n, ev) {
  svg.classList.add('is-interacting');
  const neigh = getNeighbors(n.id);
  
  nodeEls.forEach(el => {
    if(neigh.has(el.dataset.id)) el.classList.add('active');
    else el.classList.remove('active');
  });
  
  linkEls.forEach((el,i) => { 
    const l=links[i]; 
    if(l.source.id === n.id || l.target.id === n.id) el.classList.add('active'); 
    else el.classList.remove('active');
  });

  // Tooltip
  tooltip.textContent = n.id + " — " + n.group;
  tooltip.classList.add('show');
  moveTooltip(ev);
}

function clearHover() {
  tooltip.classList.remove('show');
  if(!selectedNodeId) {
    svg.classList.remove('is-interacting');
    nodeEls.forEach(el => el.classList.remove('active'));
    linkEls.forEach(el => el.classList.remove('active'));
  } else {
    // Retain selected state hover equivalent
    const n = nodeById.get(selectedNodeId);
    if(n) simulateHoverState(n);
  }
}

function simulateHoverState(n) {
  const neigh = getNeighbors(n.id);
  nodeEls.forEach(el => {
    if(neigh.has(el.dataset.id)) el.classList.add('active');
    else el.classList.remove('active');
    if(el.dataset.id === n.id) el.classList.add('selected');
    else el.classList.remove('selected');
  });
  linkEls.forEach((el,i) => { 
    const l=links[i]; 
    if(l.source.id === n.id || l.target.id === n.id) el.classList.add('active'); 
    else el.classList.remove('active');
  });
}

function moveTooltip(ev) {
  const rect = chart.getBoundingClientRect();
  tooltip.style.left = (ev.clientX - rect.left) + 'px';
  tooltip.style.top = (ev.clientY - rect.top) + 'px';
}

function openDetails(n) {
  selectedNodeId = n.id;
  svg.classList.add('is-interacting');
  simulateHoverState(n);
  
  const neighIds = [...getNeighbors(n.id)].filter(x=>x!==n.id);
  const connectionsHtml = neighIds.length > 0 
    ? neighIds.map(id => `<span class="conn-tag">${escapeHtml(id)}</span>`).join('')
    : '<span class="conn-tag" style="background:transparent;border:none;">Aucune connexion visible</span>';

  detailsContent.innerHTML = `
    <h2>${escapeHtml(n.id)}</h2>
    <span class="pill" style="background:${colors[n.group]}">${escapeHtml(n.group)}</span>
    <p>${escapeHtml(n.detail)}</p>
    <div class="connections-box">
      <div class="conn-title">Réseau direct (${neighIds.length})</div>
      <div class="conn-list">${connectionsHtml}</div>
    </div>
  `;
  rightSidebar.classList.add('active');
}

document.getElementById('close-details').addEventListener('click', () => {
  rightSidebar.classList.remove('active');
  selectedNodeId = null;
  svg.classList.remove('is-interacting');
  nodeEls.forEach(el => el.classList.remove('active', 'selected'));
  linkEls.forEach(el => el.classList.remove('active'));
});

function escapeHtml(s) { return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])); }

function applyFilters() {
  const q = document.getElementById('search').value.trim().toLowerCase(); let visible = 0;
  nodeEls.forEach((el,i) => { 
    const n = nodes[i]; 
    const ok = activeGroups.has(n.group) && (!q || (n.id + " " + n.group + " " + n.detail).toLowerCase().includes(q)); 
    el.classList.toggle('hidden', !ok); 
    if(ok) visible++; 
  });
  linkEls.forEach((el,i) => { 
    const l = links[i]; 
    const sEl = nodeEls[nodes.indexOf(l.source)], tEl = nodeEls[nodes.indexOf(l.target)]; 
    el.classList.toggle('hidden', sEl.classList.contains('hidden') || tEl.classList.contains('hidden')); 
  });
  countEl.textContent = `${visible} nœuds structurels affichés sur ${nodes.length}`;
}

document.getElementById('search').addEventListener('input', applyFilters); applyFilters();

document.getElementById('reset').onclick = () => {
  document.getElementById('search').value = ""; 
  document.querySelectorAll('#checks input').forEach(cb => { cb.checked=true; activeGroups.add(cb.value); }); 
  applyFilters();
  document.getElementById('close-details').click();
  document.getElementById('center').click();
};

document.getElementById('center').onclick = () => { currentZoom = 1; panX = 0; panY = 0; updateTransform(); };

function drag(el,n) {
  let down=false, ox=0, oy=0;
  el.addEventListener('pointerdown', ev => { 
    down=true; n.fixed=true; el.setPointerCapture(ev.pointerId); 
    const pt = toSvg(ev); ox = n.x-pt.x; oy=n.y-pt.y; 
    ev.stopPropagation(); // Prevent panning when dragging nodes
  });
  el.addEventListener('pointermove', ev => { if(!down) return; const pt=toSvg(ev); n.x=pt.x+ox; n.y=pt.y+oy; });
  el.addEventListener('pointerup', ev => { down=false; n.fixed = false; el.releasePointerCapture(ev.pointerId); });
}

let currentZoom=1, panX=0, panY=0, panning=false, sx=0, sy=0;
function updateTransform() { g.setAttribute('transform', `translate(${panX},${panY}) scale(${currentZoom})`); }
function toSvg(ev) { const rect = svg.getBoundingClientRect(); return {x:(ev.clientX-rect.left-panX)/currentZoom, y:(ev.clientY-rect.top-panY)/currentZoom}; }

svg.addEventListener('wheel', ev => { 
  ev.preventDefault(); 
  const scale = ev.deltaY < 0 ? 1.08 : 0.92; 
  currentZoom = Math.max(0.2, Math.min(3, currentZoom*scale)); 
  updateTransform(); 
}, {passive:false});

chart.addEventListener('pointerdown', ev => { 
  if(ev.target===svg || ev.target===g || ev.target.classList.contains('link')) { 
    panning=true; sx=ev.clientX-panX; sy=ev.clientY-panY; 
    chart.style.cursor='grabbing'; 
  } 
});
window.addEventListener('pointermove', ev => { if(panning) { panX=ev.clientX-sx; panY=ev.clientY-sy; updateTransform(); } });
window.addEventListener('pointerup', () => { panning=false; chart.style.cursor='grab'; });
window.addEventListener('resize', () => { 
  width = chart.clientWidth; height = chart.clientHeight; 
  svg.setAttribute('viewBox', [0,0,width,height].join(' ')); 
});
</script>
